{
  "schemaVersion": 1,
  "id": "tabnamedimmer",
  "version": "${version}",
  "name": "Tab Name Dimmer",
  "description": "Organizes tracked players into groups and highlights, filters, sorts, outlines, or shows them in a configurable Tab HUD.",
  "icon": "assets/tabnamedimmer/icon.png",
  "authors": [
    "LTS_Server"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.lts.tabnamedimmer.TabNameDimmerClient"
    ],
    "modmenu": [
      "org.lts.tabnamedimmer.compat.TabNameDimmerModMenu"
    ]
  },
  "mixins": [
    {
      "config": "tabnamedimmer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-networking-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-mapping-api-v1": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
